{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@oneatlas/database": ["../packages/database/src/index.ts"],
      "@oneatlas/database/*": ["../packages/database/src/*"],
      "@oneatlas/shared": ["../packages/shared/src/index.ts"],
      "@oneatlas/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
