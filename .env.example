# ==============================================================================
# OneAtlas Environment Variables Template
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Application Runtime Database Connection (Pooled connection for high-concurrency runtime)
# Example Local: postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public
# Example Supabase/Neon: postgresql://[user]:[password]@[host]:6543/[db]?pgbouncer=true
DATABASE_URL=""

# Direct Migration Connection (Non-pooled direct connection for Prisma CLI migrations)
# Required when using connection poolers like PgBouncer or Supabase transaction poolers
DIRECT_URL=""

# Database Connection Pool Sizing
DB_POOL_MAX=10

# Application Environment (development, test, production)
NODE_ENV="development"

# OpenRouter API Integration (Phase 3A)
# Optional for public model and provider catalog; recommended for authenticated limits
OPENROUTER_API_KEY="your-openrouter-api-key"

# OpenRouter Read-Only Management Key (Optional: required for /models/{author}/{slug}/endpoints listing)
OPENROUTER_MANAGEMENT_KEY="your-read-only-management-key"


# Backend Deployment URL (Optional for Vercel -> Render proxy rewrites)
# Leave empty for local same-origin development
NEXT_PUBLIC_BACKEND_URL="https://your-backend-api"

# ==============================================================================
# Clerk Authentication Configuration
# Retrieve these from your Clerk Dashboard: https://dashboard.clerk.com
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/models"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/models"
