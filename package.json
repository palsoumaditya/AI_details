{
  "name": "oneatlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/database",
    "packages/shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @oneatlas/frontend",
    "build": "npm run build -w @oneatlas/frontend",
    "start": "npm run start -w @oneatlas/frontend",
    "lint": "npm run lint -w @oneatlas/frontend",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p packages/database/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "db:validate": "npm run db:validate -w @oneatlas/database",
    "db:generate": "npm run db:generate -w @oneatlas/database",
    "db:migrate:dev": "npm run db:migrate:dev -w @oneatlas/database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @oneatlas/database",
    "db:migrate:status": "npm run db:migrate:status -w @oneatlas/database",
    "db:seed": "npm run db:seed -w @oneatlas/database",
    "db:studio": "npm run db:studio -w @oneatlas/database",
    "db:smoke-test": "npm run db:smoke-test -w @oneatlas/backend",
    "sync:openrouter": "npm run sync:openrouter -w @oneatlas/backend",
    "sync:modelsdev": "npm run sync:modelsdev -w @oneatlas/backend",
    "sync:all": "npm run sync:all -w @oneatlas/backend",
    "test:openrouter": "npm run test:openrouter -w @oneatlas/backend",
    "test:modelsdev": "npm run test:modelsdev -w @oneatlas/backend",
    "test:resolution": "npm run test:resolution -w @oneatlas/backend",
    "test:coordinator": "npm run test:coordinator -w @oneatlas/backend",
    "audit:data-integrity": "npm run audit:data-integrity -w @oneatlas/backend",
    "audit:provenance": "npm run audit:provenance -w @oneatlas/backend",
    "audit:conflicts": "npm run audit:conflicts -w @oneatlas/backend",
    "audit:endpoints": "npm run audit:endpoints -w @oneatlas/backend",
    "postinstall": "npm run db:generate -w @oneatlas/database"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
